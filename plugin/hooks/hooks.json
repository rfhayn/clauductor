{
  "description": "Stridal's operating-model hooks. Each runs only in a repository /stridal:init set up (.claude/stridal-plugin).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" format.sh",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Agent|Task",
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-silent-wait.sh",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" cd-guard.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" pr-merge-guard.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-blind-source-rewrite.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-background-gate.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-silent-wait.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" cd-guard.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" catch-up-guard.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" read-by-range.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-worktree-force-remove.sh",
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-pattern-kill.sh",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" read-by-range.sh",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-silent-wait.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" pattern-kill-path.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/plugin-session.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" cd-guard.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-silent-wait.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-silent-wait.sh",
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" no-silent-wait.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/if-project.sh\" focus-staleness.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
