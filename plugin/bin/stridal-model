#!/bin/sh
# stridal-model: run one of the stridal plugin's scripts by its path in the plugin.
#
#   stridal-model checks/run.sh [names]     the process checks
#   stridal-model status-write.sh "<focus>" the status-line focus
#   stridal-model root                      print the plugin root
#
# The plugin's bin/ is on the Bash tool's PATH while the plugin is enabled, and this file's own
# location is the plugin version that is loaded, so a rule or a permission can name one stable
# command instead of a plugin-cache path that changes with every version. Generated by
# `stridal plugin build` (framework/internal/plugin/assets).
root=$(cd "$(dirname "$0")/.." && pwd) || exit 1
case "${1:-}" in
  "" | -h | --help)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  root) printf '%s\n' "$root"; exit 0 ;;
  /* | *..*) echo "stridal-model: '$1' must be a path inside the plugin" >&2; exit 2 ;;
esac
s=$1; shift
[ -f "$root/$s" ] || { echo "stridal-model: no such script in the plugin: $s ($root)" >&2; exit 2; }
exec sh "$root/$s" "$@"
