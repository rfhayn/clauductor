{
  "model": "opus",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "skillOverrides": {
    "anthropic-skills:brand-guidelines": "user-invocable-only",
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:deep-research": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "deep-research": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only"
  },
  "statusLine": {
    "command": "f=\"${CLAUDE_CODE_PLUGIN_CACHE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins}/data/stridal-stridal/statusline.sh\"; [ -f \"$f\" ] && sh \"$f\"",
    "type": "command"
  },
  "permissions": {
    "allow": [
      "Bash(stridal-model checks/run.sh)",
      "Bash(stridal-model checks/run.sh *)",
      "Bash(stridal-model owner-queue.sh)",
      "Bash(stridal-model roadmap-queue.sh)",
      "Bash(stridal-model roadmap-queue.sh *)",
      "Bash(scripts/ci/gate.sh)",
      "Bash(scripts/ci/gate.sh *)",
      "Bash(scripts/ci/gate-wait.sh)",
      "Bash(scripts/ci/gate-wait.sh *)",
      "Bash(stridal-model status-write.sh *)",
      "Bash(stridal lane close *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!./.env.example)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(sudo *)",
      "Bash(tmux *kill-server*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(cmd.exe *)",
      "Bash(powershell.exe *)",
      "Bash(pwsh.exe *)",
      "Bash(wsl.exe *)",
      "Bash(explorer.exe *)",
      "Bash(clip.exe *)",
      "Bash(notepad.exe *)",
      "Bash(/mnt/c/*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git *",
      "gh *",
      "tmux *",
      "stridal *",
      "docker *",
      "scripts/ci/run-local.sh *",
      "scripts/ci/gate.sh",
      "scripts/ci/gate.sh *",
      "scripts/ci/gate-wait.sh",
      "scripts/ci/gate-wait.sh *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        }
      ]
    }
  },
  "extraKnownMarketplaces": {
    "stridal": {
      "source": {
        "repo": "rfhayn/stridal",
        "source": "github"
      }
    }
  },
  "enabledPlugins": {
    "stridal@stridal": true
  }
}
