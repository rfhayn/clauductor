#!/bin/bash
# A fake `claude` for the UX harness (up.sh copies it onto the panel's PATH). Synthetic
# data only; it never talks to Anthropic. Everything it keeps is under $HOME/fake, and
# $HOME is the harness's temp HOME (the panel passes its own HOME to each lane).
#
#   claude --version             the version the panel's heuristics were verified on
#   claude agents --json         every live fake session, with the status its role gives
#   claude auth status --json    a Max subscription (the fixture the panel's tests use)
#   claude [-n lane] [--session-id id | --resume id] ...
#                                interactive: a TUI-ish screen that asks for every mouse
#                                mode (1000/1002/1003/1006), prints a URL and two OSC 8
#                                links, records the bytes typed into it, and acts out
#                                its role (below) by posting hooks and status lines.
#
# A lane's role comes from $HOME/fake/role/<lane> if present, else from its name:
#   work*   busy, with subagents starting and stopping (hooks), context 64%
#   wait*   waiting on a permission prompt (Notification + PermissionRequest hooks)
#   stream* busy, printing a long-running output stream
#   budget* busy, well over any budget figure the build may show (cost $48)
#   anything else: idle, its turn done (UserPromptSubmit then Stop)
# Typed bytes go to $HOME/typed.log and $HOME/fake/typed/<lane>.log; "/exit" + Enter
# ends the session, as claude's own /exit does. Each interactive start records its argv in
# $HOME/fake/argv/<lane> (so a flow can see --remote-control).
# The 5-hour window every status post reports is 42% resetting in 2 h, unless a flow
# writes $HOME/fake/five_hour_pct (a number) or $HOME/fake/five_hour_resets (unix
# seconds): economy mode's hysteresis and auto-resume's reset are driven that way (UX-2).
set -u
F="$HOME/fake"
mkdir -p "$F/agents" "$F/status" "$F/typed" "$F/role" "$F/argv"

now_ms() { perl -MTime::HiRes=time -e 'printf "%d\n", time*1000'; }
port() { cat "$HOME/.clauductor/panel/port" 2>/dev/null; }
post() { # post <path> <json>
  local p; p=$(port)
  [ -n "$p" ] || return 0
  curl -s --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary "$2" "http://127.0.0.1:$p$1" >/dev/null 2>&1 || true
}
hook() { post "/hook?src=clauductor-panel" "$1"; }

case "${1:-}" in
  --version) echo "2.1.284 (Claude Code)"; exit 0 ;;
  auth)
    cat <<'JSON'
{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"firstParty","email":"dev@example.com","orgId":"00000000-0000-4000-8000-000000000010","orgName":"Example Org Ltd","subscriptionType":"max"}
JSON
    exit 0 ;;
  agents)
    # One entry per live fake session; its status is its status file's.
    # A session shows only once it has started (UX_FAKE_START_DELAY, default 4 s), as
    # a real claude takes seconds to; UX_FAKE_EARLY=1 shows it at once.
    t=$(now_ms) wait_ms=$(( ${UX_FAKE_START_DELAY:-4} * 1000 ))
    [ "${UX_FAKE_EARLY:-}" = 1 ] && wait_ms=0
    printf '['
    sep=""
    for f in "$F"/agents/*.json; do
      [ -f "$f" ] || continue
      pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$f")
      if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then rm -f "$f"; continue; fi
      at=$(sed -n 's/.*"startedAt":\([0-9]*\).*/\1/p' "$f")
      [ $((t - ${at:-0})) -lt "$wait_ms" ] && continue
      sid=$(basename "$f" .json)
      st=$(cat "$F/status/$sid" 2>/dev/null || echo idle)
      wf=""
      case "$st" in waiting:*) wf=${st#waiting:}; st=waiting ;; esac
      body=$(sed 's/}[[:space:]]*$//' "$f")
      printf '%s%s,"status":"%s"%s}' "$sep" "$body" "$st" "${wf:+,\"waitingFor\":\"$wf\"}"
      sep=","
    done
    printf ']\n'
    exit 0 ;;
esac

# Interactive.
argv="$*"
lane=${CLAUDUCTOR_LANE:-}
sid=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) lane=${lane:-$2}; shift ;;
    --session-id|--resume) sid=$2; shift ;;
  esac
  shift
done
[ -n "$sid" ] || sid=$(uuidgen | tr 'A-Z' 'a-z')
[ -n "$lane" ] || lane=lane
printf '%s\n' "$argv" > "$F/argv/$lane"
role=$(cat "$F/role/$lane" 2>/dev/null || true)
if [ -z "$role" ]; then
  case "$lane" in work*) role=busy ;; wait*) role=waiting ;; stream*) role=stream ;; budget*) role=budget ;; *) role=idle ;; esac
fi
cwd=$(pwd -P)
me=$$
printf '{"pid":%d,"cwd":"%s","kind":"interactive","startedAt":%s,"sessionId":"%s","name":"%s"}\n' \
  "$me" "$cwd" "$(now_ms)" "$sid" "$lane" > "$F/agents/$sid.json"
case "$role" in busy|stream|budget) echo busy > "$F/status/$sid" ;; waiting) echo "waiting:permission: Bash(npm run test:e2e)" > "$F/status/$sid" ;; *) echo idle > "$F/status/$sid" ;; esac

status_post() { # status_post <context pct> <cost>
  local t q r; t=$(date +%s)
  q=$(cat "$F/five_hour_pct" 2>/dev/null || true); [[ "$q" =~ ^[0-9]+$ ]] || q=42
  r=$(cat "$F/five_hour_resets" 2>/dev/null || true); [[ "$r" =~ ^[0-9]+$ ]] || r=$((t+7200))
  post /status "{\"session_id\":\"$sid\",\"cwd\":\"$cwd\",\"version\":\"2.1.284\",\"workspace\":{\"current_dir\":\"$cwd\"},\"model\":{\"id\":\"claude-opus-4-1\",\"display_name\":\"Opus 4.1\"},\"cost\":{\"total_cost_usd\":$2,\"total_duration_ms\":1800000,\"total_api_duration_ms\":600000,\"total_lines_added\":412,\"total_lines_removed\":97},\"context_window\":{\"total_input_tokens\":128000,\"total_output_tokens\":9100,\"context_window_size\":200000,\"used_percentage\":$1,\"current_usage\":{\"input_tokens\":10,\"output_tokens\":63,\"cache_creation_input_tokens\":10579,\"cache_read_input_tokens\":26394}},\"prompt_cache\":{\"warm\":true,\"hit_ratio\":0.92,\"expires_at\":$((t+1800)),\"requests\":14,\"misses\":1,\"recache_tokens_if_cold\":36983},\"fast_mode\":false,\"thinking\":{\"enabled\":true},\"output_style\":{\"name\":\"default\"},\"rate_limits\":{\"five_hour\":{\"used_percentage\":$q,\"resets_at\":$r},\"seven_day\":{\"used_percentage\":61,\"resets_at\":$((t+259200))}}}"
}
ev() { # ev <event> [extra json fields]
  hook "{\"session_id\":\"$sid\",\"cwd\":\"$cwd\",\"hook_event_name\":\"$1\"${2:+,$2}}"
}

# The screen: what claude's fullscreen TUI asks for, and what the flows click.
printf '\033[?1000h\033[?1002h\033[?1003h\033[?1006h\033[?2004h' # every mouse mode, and bracketed paste
printf '\033[1;38;5;208m╭──────────────────────────────────────────────────────╮\033[0m\r\n'
printf '\033[1;38;5;208m│\033[0m ✻ Welcome to \033[1mClaude Code\033[0m (UX harness fake)              \033[1;38;5;208m│\033[0m\r\n'
printf '\033[1;38;5;208m│\033[0m   lane \033[36m%-20s\033[0m role \033[33m%-8s\033[0m             \033[1;38;5;208m│\033[0m\r\n' "$lane" "$role"
printf '\033[1;38;5;208m╰──────────────────────────────────────────────────────╯\033[0m\r\n'
printf ' cwd: %s\r\n\r\n' "$cwd"
printf 'Selectable words on this row\r\n'
printf 'PR: https://github.com/o/r/pull/12 is open.\r\n'
printf '\033]8;;https://example.com/elsewhere\033\\Docs here\033]8;;\033\\ and \033]8;;https://example.com/same\033\\https://example.com/same\033]8;;\033\\\r\n'
printf '\033[2m  ⎿ Read(src/app.ts) · 212 lines\033[0m\r\n'
printf '\033[32m  ✓\033[0m Tests: 128 passed, 0 failed \033[2m(4.2s)\033[0m\r\n\r\n'
case "$role" in
  waiting) printf '\033[33m╭─ Permission ─────────────────────────────────╮\r\n│ Bash(npm run test:e2e)                        │\r\n│ ❯ 1. Yes   2. Yes, and don'"'"'t ask again   3. No │\r\n╰───────────────────────────────────────────────╯\033[0m\r\n' ;;
esac
printf '\033[2m────────────────────────────────────────────────────────\033[0m\r\n> '

# The role, acted out in the background while the session lives.
(
  # Real claude takes seconds to start. A hook in the lane's first instant can reach
  # the panel before its worktree list has the new worktree, and the panel then binds
  # the session to the enclosing worktree (the project root) for good; UX_FAKE_EARLY=1
  # reproduces that (see docs/ux-passes.md, findings).
  [ "${UX_FAKE_EARLY:-}" = 1 ] || sleep "${UX_FAKE_START_DELAY:-4}"
  ev UserPromptSubmit '"prompt":"(ux harness)"'
  n=0
  # Alive: the session runs and has not ended (its record goes first when it ends).
  while kill -0 "$me" 2>/dev/null && [ -f "$F/agents/$sid.json" ]; do
    case "$role" in
      busy)
        status_post 64 3.1
        if [ $((n % 3)) -eq 0 ]; then
          a="a$(printf '%08x' $((RANDOM * 32768 + RANDOM)))"
          tu="toolu_$a"
          ev PreToolUse "\"tool_name\":\"Agent\",\"tool_use_id\":\"$tu\",\"tool_input\":{\"subagent_type\":\"Explore\",\"description\":\"Survey the code\"}"
          ev SubagentStart "\"agent_id\":\"$a\",\"agent_type\":\"Explore\""
          ev PostToolUse "\"tool_name\":\"Agent\",\"tool_use_id\":\"$tu\",\"tool_response\":{\"agentId\":\"$a\"}"
          [ -n "${prev:-}" ] && ev SubagentStop "\"agent_id\":\"$prev\",\"agent_type\":\"Explore\""
          prev=$a
        fi ;;
      waiting)
        status_post 31 0.8
        [ $((n % 6)) -eq 0 ] && { ev Notification '"notification_type":"permission_prompt","message":"Claude needs your permission to use Bash","title":"Permission"'; ev PermissionRequest '"tool_name":"Bash"'; } ;;
      stream)
        status_post 88 7.4
        # One general-purpose agent at a time: each stops the one before.
        if [ $((n % 4)) -eq 0 ]; then
          [ "$n" -gt 0 ] && ev SubagentStop "\"agent_id\":\"s$((n - 4))\",\"agent_type\":\"general-purpose\""
          ev SubagentStart "\"agent_id\":\"s$n\",\"agent_type\":\"general-purpose\""
        fi ;;
      budget)
        status_post 71 48.25 ;;
      *)
        status_post 12 0.2
        [ "$n" -eq 0 ] && ev Stop '"last_assistant_message":"Done."' ;;
    esac
    n=$((n + 1))
    sleep 5
  done
) >/dev/null 2>&1 &

if [ "$role" = stream ]; then
  (
    i=0
    while kill -0 "$me" 2>/dev/null; do
      i=$((i + 1))
      printf '\r\n\033[2m%s\033[0m \033[36m[build]\033[0m step %05d compiling module-%03d.ts … \033[32mok\033[0m (%d ms)' "$(date +%H:%M:%S)" "$i" $((i % 997)) $((i * 7 % 900))
      sleep 0.4
    done
  ) &
fi

# Leaving, as claude does: a SessionEnd hook, and no longer in `claude agents`. On
# /exit (reason prompt_input_exit), or when tmux ends the session (a hangup).
ended=""
bye() {
  [ -n "$ended" ] && return
  ended=1
  rm -f "$F/agents/$sid.json"
  ev SessionEnd "\"reason\":\"$1\""
}
trap 'bye other; exit 0' HUP TERM INT

# The input: raw bytes, recorded; printable ones echoed so a screenshot shows them.
stty raw -echo 2>/dev/null
perl -e '
  $| = 1; binmode STDIN; binmode STDOUT;
  open(my $a, ">>", $ARGV[0]) or die; open(my $b, ">>", $ARGV[1]) or die;
  my $tail = "";
  while (sysread(STDIN, my $buf, 4096)) {
    syswrite($a, $buf); syswrite($b, $buf);
    print $buf if $buf !~ /[\x00-\x1f\x7f]/;
    print "\r\n\e[33mInterrupted\e[0m by user\r\n> " if $buf eq "\e";
    $tail = substr($tail . $buf, -64);
    exit 0 if $tail =~ m{/exit[\r\n]};
  }' "$HOME/typed.log" "$F/typed/$lane.log"
stty sane 2>/dev/null
bye prompt_input_exit
