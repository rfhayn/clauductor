{
  "name": "My Project",
  "lanes": {
    "change/": "build",
    "fix/": "fix",
    "ops/": "ops",
    "main": "orchestrator"
  },
  "cards": [
    {
      "id": "todo",
      "title": "TODOs",
      "command": ["sh", "-c", "grep -rn TODO src | head -20"],
      "refresh": "watch:src"
    },
    {
      "id": "releases",
      "title": "Recent releases",
      "command": ["sh", "-c", "gh release list --limit 5 --json tagName,publishedAt | jq '[.[] | {title: .tagName, published: .publishedAt}]'"],
      "refresh": "interval:300"
    }
  ]
}
